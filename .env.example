# OneSync Environment Configuration
# Author: https://sibansal.dev/

# ---- Microsoft identity ----
MAIN_VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MAIN_VITE_MS_AUTHORITY=https://login.microsoftonline.com/common
MAIN_VITE_MS_REDIRECT_URI=dev.sibansal.onesync://auth
MAIN_VITE_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# ---- Sync tuning ----
MAIN_VITE_SYNC_CONCURRENCY=4
MAIN_VITE_MAX_RETRIES=5
MAIN_VITE_RETRY_BASE_DELAY_MS=1000
MAIN_VITE_MASS_MOVE_THRESHOLD=0.3

# ---- Behaviour flags (dev only) ----
MAIN_VITE_USE_MOCK_DRIVE=false
MAIN_VITE_ALLOW_INTERNAL_DESTINATION=false
MAIN_VITE_LOG_LEVEL=info

# ---- Renderer ----
RENDERER_VITE_APP_NAME=OneSync
RENDERER_VITE_AUTHOR_URL=https://sibansal.dev/
